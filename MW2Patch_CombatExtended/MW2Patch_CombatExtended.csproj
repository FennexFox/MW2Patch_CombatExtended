<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <OutputType>Library</OutputType>
    <RootNamespace>MW2Patch_CombatExtended</RootNamespace>
    <AssemblyName>MW2Patch_CombatExtended</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Deterministic>true</Deterministic>
    <RimWorld17Dir Condition="'$(RimWorld17Dir)' == ''">$(MW2CE_RIMWORLD17_DIR)</RimWorld17Dir>
    <CombatExtendedReference Condition="'$(CombatExtendedReference)' == ''">$(RimWorld17Dir)\Mods\CombatExtended\Assemblies\CombatExtended.dll</CombatExtendedReference>
    <HarmonyReference Condition="'$(HarmonyReference)' == ''">$(RimWorld17Dir)\Mods\Harmony\1.7\Assemblies\0Harmony.dll</HarmonyReference>
    <ModularWeapons2Reference Condition="'$(ModularWeapons2Reference)' == ''">$(RimWorld17Dir)\Mods\ModularWeapons2\1.7\Assemblies\ModularWeapons2.dll</ModularWeapons2Reference>
  </PropertyGroup>

  <Target Name="ValidateBuildReferences" BeforeTargets="ResolveReferences">
    <Error Condition="'$(RimWorld17Dir)' == ''" Text="Set RimWorld17Dir (or MW2CE_RIMWORLD17_DIR) to the RimWorld 1.7 game directory." />
    <Error Condition="!Exists('$(RimWorld17Dir)\Assembly-CSharp.dll')" Text="RimWorld 1.7 Assembly-CSharp.dll was not found under $(RimWorld17Dir)." />
    <Error Condition="!Exists('$(CombatExtendedReference)')" Text="Combat Extended reference assembly was not found at $(CombatExtendedReference)." />
    <Error Condition="!Exists('$(HarmonyReference)')" Text="Harmony 1.7 assembly was not found at $(HarmonyReference)." />
    <Error Condition="!Exists('$(ModularWeapons2Reference)')" Text="ModularWeapons2 1.7 assembly was not found at $(ModularWeapons2Reference)." />
  </Target>

  <ItemGroup>
    <Reference Include="0Harmony" HintPath="$(HarmonyReference)" Private="false" />
    <Reference Include="Assembly-CSharp" HintPath="$(RimWorld17Dir)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="CombatExtended" HintPath="$(CombatExtendedReference)" Private="false" />
    <Reference Include="ModularWeapons2" HintPath="$(ModularWeapons2Reference)" Private="false" />
    <Reference Include="UnityStubs" HintPath="$(RimWorld17Dir)\UnityStubs.dll" Private="false" />
    <Reference Include="Waylith" HintPath="$(RimWorld17Dir)\Waylith.dll" Private="false" />
  </ItemGroup>
</Project>
