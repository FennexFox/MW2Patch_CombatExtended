<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationSequence">
    <operations>
      <li Class="PatchOperationReplace">
        <xpath>/Defs/ThingDef[defName="CE_Gun_Savage_TwentyFourHundred"]/graphicData/graphicClass</xpath>
        <value>
          <graphicClass>ModularWeapons2.Graphic_UniqueByComp</graphicClass>
        </value>
      </li>
      <li Class="PatchOperationConditional">
        <xpath>/Defs/ThingDef[defName="CE_Gun_Savage_TwentyFourHundred"]/graphicData/drawSize</xpath>
        <match Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName="CE_Gun_Savage_TwentyFourHundred"]/graphicData/drawSize</xpath>
          <value>
            <drawSize>2.4</drawSize>
          </value>
        </match>
        <nomatch Class="PatchOperationAdd">
          <xpath>/Defs/ThingDef[defName="CE_Gun_Savage_TwentyFourHundred"]/graphicData</xpath>
          <value>
            <drawSize>2.4</drawSize>
          </value>
        </nomatch>
      </li>
      <li Class="PatchOperationAdd">
        <xpath>/Defs/ThingDef[defName="CE_Gun_Savage_TwentyFourHundred"]/comps</xpath>
        <value>
          <li Class="ModularWeapons2.CompProperties_ModularWeapon">
            <baseGraphicData>
              <texPath>Things/Weapons/Savage2400</texPath>
              <graphicClass>Graphic_Single</graphicClass>
              <drawSize>(1.2,1.2)</drawSize>
            </baseGraphicData>
            <partsMounts>
              <!-- Keep the native rifle/shotgun pair; no extra underbarrel mount is added. -->
              <li>
                <mountDef>MountSight_Long</mountDef>
                <offset>(0.02,0.055)</offset>
                <adapterGraphic>
                  <texPath>ModularParts/Adapters/Upward</texPath>
                  <graphicClass>Graphic_Single</graphicClass>
                </adapterGraphic>
                <layerOrder>1</layerOrder>
              </li>
              <li>
                <mountDef>MountTacDevice_Side</mountDef>
                <offset>(0.16,-0.012)</offset>
                <adapterGraphic>
                  <texPath>ModularParts/Adapters/Side</texPath>
                  <graphicClass>Graphic_Single</graphicClass>
                </adapterGraphic>
                <layerOrder>2</layerOrder>
              </li>
            </partsMounts>
          </li>
        </value>
      </li>
    </operations>
  </Operation>
</Patch>
