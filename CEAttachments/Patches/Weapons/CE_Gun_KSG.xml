<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationSequence">
    <operations>
      <li Class="PatchOperationReplace">
        <xpath>/Defs/ThingDef[defName="CE_Gun_KSG"]/graphicData/graphicClass</xpath>
        <value>
          <graphicClass>ModularWeapons2.Graphic_UniqueByComp</graphicClass>
        </value>
      </li>
      <li Class="PatchOperationConditional">
        <xpath>/Defs/ThingDef[defName="CE_Gun_KSG"]/graphicData/drawSize</xpath>
        <match Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName="CE_Gun_KSG"]/graphicData/drawSize</xpath>
          <value>
            <drawSize>2</drawSize>
          </value>
        </match>
        <nomatch Class="PatchOperationAdd">
          <xpath>/Defs/ThingDef[defName="CE_Gun_KSG"]/graphicData</xpath>
          <value>
            <drawSize>2</drawSize>
          </value>
        </nomatch>
      </li>
      <li Class="PatchOperationAdd">
        <xpath>/Defs/ThingDef[defName="CE_Gun_KSG"]/comps</xpath>
        <value>
          <li Class="ModularWeapons2.CompProperties_ModularWeapon">
            <baseGraphicData>
              <texPath>Things/Weapons/KSG</texPath>
              <graphicClass>Graphic_Single</graphicClass>
            </baseGraphicData>
            <partsMounts>
              <!-- Do not expose a third underbarrel slot: CE uses its second tube there. -->
              <li>
                <mountDef>MountSight_Mid</mountDef>
                <offset>(0.215,0.082)</offset>
                <adapterGraphic>
                  <texPath>ModularParts/Adapters/Upward</texPath>
                  <graphicClass>Graphic_Single</graphicClass>
                </adapterGraphic>
                <layerOrder>1</layerOrder>
              </li>
              <li>
                <mountDef>MountMuzzle_Shotgun</mountDef>
                <offset>(0.45,0.02)</offset>
                <layerOrder>1</layerOrder>
              </li>
              <li>
                <mountDef>MountTacDevice_Side</mountDef>
                <offset>(0.21,-0.025)</offset>
                <adapterGraphic>
                  <texPath>ModularParts/Adapters/Side</texPath>
                  <graphicClass>Graphic_Single</graphicClass>
                </adapterGraphic>
                <layerOrder>2</layerOrder>
              </li>
            </partsMounts>
          </li>
        </value>
      </li>
    </operations>
  </Operation>
</Patch>
