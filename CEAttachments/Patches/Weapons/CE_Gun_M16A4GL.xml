<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationSequence">
    <operations>
      <li Class="PatchOperationReplace">
        <xpath>/Defs/ThingDef[defName="CE_Gun_M16A4GL"]/graphicData/graphicClass</xpath>
        <value>
          <graphicClass>ModularWeapons2.Graphic_UniqueByComp</graphicClass>
        </value>
      </li>
      <li Class="PatchOperationConditional">
        <xpath>/Defs/ThingDef[defName="CE_Gun_M16A4GL"]/graphicData/drawSize</xpath>
        <match Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName="CE_Gun_M16A4GL"]/graphicData/drawSize</xpath>
          <value>
            <drawSize>2.32</drawSize>
          </value>
        </match>
        <nomatch Class="PatchOperationAdd">
          <xpath>/Defs/ThingDef[defName="CE_Gun_M16A4GL"]/graphicData</xpath>
          <value>
            <drawSize>2.32</drawSize>
          </value>
        </nomatch>
      </li>
      <li Class="PatchOperationAdd">
        <xpath>/Defs/ThingDef[defName="CE_Gun_M16A4GL"]/comps</xpath>
        <value>
          <li Class="ModularWeapons2.CompProperties_ModularWeapon">
            <baseGraphicData>
              <texPath>Things/Weapons/M16A4_GL</texPath>
              <graphicClass>Graphic_Single</graphicClass>
              <drawSize>(1.16,1.16)</drawSize>
            </baseGraphicData>
            <partsMounts>
              <!-- The native M203 remains the only underbarrel weapon. -->
              <li>
                <mountDef>MountSight_Short</mountDef>
                <offset>(-0.02,0.13)</offset>
                <adapterGraphic>
                  <texPath>ModularParts/Adapters/Upward_Bridge</texPath>
                  <graphicClass>Graphic_Single</graphicClass>
                </adapterGraphic>
                <layerOrder>1</layerOrder>
              </li>
              <li>
                <mountDef>MountMuzzle_Assault</mountDef>
                <offset>(0.45,0.0)</offset>
                <layerOrder>1</layerOrder>
              </li>
              <li>
                <mountDef>MountTacDevice_Side</mountDef>
                <offset>(0.18,-0.008)</offset>
                <adapterGraphic>
                  <texPath>ModularParts/Adapters/Side</texPath>
                  <graphicClass>Graphic_Single</graphicClass>
                </adapterGraphic>
                <layerOrder>2</layerOrder>
              </li>
            </partsMounts>
          </li>
        </value>
      </li>
    </operations>
  </Operation>
</Patch>
